# Sectors Financial API v2 Key (from https://sectors.app/api)
SECTORS_API_KEY=

# Database URL for PostgreSQL
DATABASE_URL=postgresql+asyncpg://sustainmetric:sustainmetric_secret@127.0.0.1:5432/sustainmetric_db
SYNC_DATABASE_URL=postgresql+pg8000://sustainmetric:sustainmetric_secret@127.0.0.1:5432/sustainmetric_db

# OpenRouter LLM (Nvidia Nemotron Free Model for Audit Summaries)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Cache TTL Settings (in seconds)
CACHE_TTL_FINANCIALS_SEC=604800 # 7 days
CACHE_TTL_NEWS_SEC=86400        # 24 hours
